<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <title>View User</title>
  </head>
  <body>
    <div style="width: 50%; margin: auto;">
        <h3 style="padding: 20px 0;">View detail a User <%= userId %></h3>
        <form action="/handle-update-user/<%= userId %>" method="POST">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input name="name" type="text" class="form-control" placeholder="John Doe" value="<%= user[0].name %>" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input name="email" type="email" class="form-control" placeholder="name@example.com" value="<%= user[0].email %>" />
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <textarea name="address" class="form-control" rows="1" placeholder="Enter address"><%= user[0].address %></textarea>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
        </form>
    </div>

    <script src="/javascript/bootstrap.bundle.min.js"></script>
  </body>
</html>
